# === SECRETS — NEVER commit API keys ===
.env
.env.local
.env.production

# === DEPENDENCIES (all languages) ===
node_modules/       # Node.js
__pycache__/        # Python bytecode
*.pyc               # Compiled Python
vendor/             # PHP Composer
.gradle/  build/    # Java/Kotlin

# === BUILD (regenerated on every deploy) ===
dist/   .next/   .nuxt/   out/

# === OPERATING SYSTEM ===
.DS_Store   Thumbs.db

# === LOGS AND TEMP FILES ===
*.log   npm-debug.log*
